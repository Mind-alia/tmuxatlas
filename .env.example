# Copy only the section for this machine's role to
# ~/.config/tmuxatlas/.env.

# Hub:
# Passkeys are bound to this exact browser-facing origin. Set the final URL
# before enrolling the first passkey.
TMUXATLAS_PUBLIC_URL=https://tmuxatlas.example.com

# Keep the plaintext origin on loopback when TLS terminates at Cloudflare
# Tunnel, Nginx, or another trusted gateway.
TMUXATLAS_LISTEN=127.0.0.1:7654

# Browser sessions expire after this much inactivity. Go duration syntax is
# supported, for example 24h, 168h (7 days), or 720h (30 days).
TMUXATLAS_SESSION_TTL=24h

# Mode optionnel avec comptes Atlas. Amorcer d’abord l’administrateur avec
# « tmuxatlas users bootstrap-admin ». Incompatible avec TMUXATLAS_NO_AUTH.
# TMUXATLAS_AUTH=accounts
# Attribuer l’hôte du hub à un invité (seulement si le hub ne tourne pas sous un compte sensible)
# TMUXATLAS_GUEST_LOCAL_HOST=allow

# Host monitoring runs on every role except the hub. It polls apt, systemctl and
# journalctl and probes the URLs below plus those found in the Caddy config.
# TMUXATLAS_MONITOR=off
# TMUXATLAS_MONITOR_URLS=https://example.com,https://status.example.com

# Ops (admin only): containers and backups read from files written by the
# production account, and phone notifications. See docs/ops.md.
# TMUXATLAS_OPS_DIR=/srv/tf-ops
# TMUXATLAS_OPS_NOTIFY=off
# Optional ntfy channel (Android and iOS app). The topic name acts as a
# password on ntfy.sh: pick a long random one. Keep the real values in
# ~/.config/tmuxatlas/.env, never in git.
# TMUXATLAS_NTFY_URL=https://ntfy.sh/atlas-<random>
# TMUXATLAS_NTFY_TOKEN=

# Browser microphone for programs on this host such as Claude Code /voice. Changes
# this user's default audio source; needs pulseaudio and libasound2-plugins. See docs/voice.md.
# TMUXATLAS_VOICE=on

# Agent (do not set TMUXATLAS_PUBLIC_URL on an Agent-only machine):
# TMUXATLAS_HUB=https://tmuxatlas.example.com
# TMUXATLAS_PEER_OUTCOME_TTL=5m
# TMUXATLAS_PEER_OUTCOME_MAX_ENTRIES=1024
# TMUXATLAS_PEER_OUTCOME_MAX_BYTES=65536

# Project roots on the session host, separated by commas or colons.
# TMUXATLAS_PROJECT_DIRS=~/Project,~/projects,~/code,~/src,~/dev
